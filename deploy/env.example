# Copy to .env and fill in — never commit the real file.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# AES-256 master key (env wins over key-file sidecar)
CONTEXT_M_MASTER_KEY=replace-me

# API key for the snapshot sidecar: create one after first boot
#   curl -X POST localhost:8900/v1/keys -H "Authorization: Bearer <admin-key>" \
#        -d '{"role":"operator","label":"snapshot-bot"}'
CTXM_ADMIN_KEY=replace-me
